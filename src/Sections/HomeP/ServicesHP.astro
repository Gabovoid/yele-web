---
const services = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap preview-icon"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"/></svg>`,
    label: "Instalaciones eléctricas",
    description: "Realizamos instalaciones eléctricas residenciales, comerciales e industriales, garantizando seguridad y eficiencia en cada proyecto.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wrench preview-icon"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></svg>`,
    label: "Mantenimiento preventivo y correctivo",
    description: "Ofrecemos servicios de mantenimiento preventivo y correctivo para garantizar el buen funcionamiento de sus instalaciones eléctricas.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circuit-board preview-icon"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M11 9h4a2 2 0 0 0 2-2V3"/><circle cx="9" cy="9" r="2"/><path d="M7 21v-4a2 2 0 0 1 2-2h4"/><circle cx="15" cy="15" r="2"/></svg>`,
    label: "Tableros eléctricos",
    description: "Diseñamos y fabricamos tableros eléctricos personalizados para cumplir con las necesidades específicas de cada cliente.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb preview-icon"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>`,
    label: "Iluminación LED",
    description: "Proporcionamos soluciones de iluminación LED eficientes y duraderas para hogares y negocios.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug-2 preview-icon"><path d="M9 2v6"/><path d="M15 2v6"/><path d="M12 17v5"/><path d="M5 8h14"/><path d="M6 11V8h12v3a6 6 0 1 1-12 0Z"/></svg>`,
    label: "Proyectos eléctricos",
    description: "Diseñamos e implementamos proyectos eléctricos a medida para cumplir con los requisitos específicos de cada cliente.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-cog preview-icon"><path d="M10.584 21H5a2 2 0 01-2-2v-9a2 2 0 01.709-1.527l7-6a2 2 0 012.582 0l7 6A2 2 0 0121 10.001v.583"/><path d="M14 12H10a1 1 0 00-1 1v8"/><path d="m14.305 19.53.923-.382"/><path d="m15.229 16.852-.924-.383"/><path d="m16.852 15.228-.383-.923"/><path d="m16.852 20.773-.383.924"/><path d="m19.148 15.228.383-.923"/><path d="m19.53 21.697-.382-.924"/><path d="m20.773 16.852.922-.383"/><path d="m20.773 19.148.92２.383"/><circle cx="18" cy="18" r="3"/></svg>`,
    label: "Soluciones industriales",
    description: "Ofrecemos soluciones eléctricas especializadas para el sector industrial, garantizando eficiencia y seguridad.",
  },
];
---

<section class="bg-white pt-12 pb-6">
  <div class="mx-auto max-w-6xl px-6">

    <div class="flex items-center justify-between">
      <h2 class="flex items-center gap-3 text-2xl font-extrabold text-yeledarkblue">
        <span class="h-0.5 w-9 bg-yeleorange"></span>
        Servicios
      </h2>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {services.map((service) => (
        <div class="flex min-h-40 flex-col items-center justify-start gap-3 rounded-lg bg-white p-4 pt-5 text-center shadow-[0_2px_12px_rgba(15,58,102,0.08)] transition hover:-translate-y-0.5 hover:shadow-md">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-yelewhiteorange text-yeleorange [&>svg]:h-6 [&>svg]:w-6" set:html={service.icon}/>
          <span class="flex h-8 items-center justify-center text-xs font-semibold leading-tight text-yeledarkblue"> {service.label}</span>
          <span class="text-[12px] leading-relaxed text-slate-500"> {service.description}</span>
        </div>
      ))}
    </div>

  </div>
</section>