---
const customers: { name: string; logo: string | null }[] = [
    { name: "DEVIDA", logo: "https://sistemas.devida.gob.pe/sgd-consulta-externa/img/logo.gif" },
    { name: "SISE", logo: "https://docs.cientifica.edu.pe/marketing/sise/aula-virtual/sise-logo.png" },
    { name: "Artesco", logo: "https://s3-us-west-2.amazonaws.com/cbi-image-service-prd/modified/d226aa63-d4ea-47a5-ac4c-bbcaa7ed48d5.png" },
    { name: "TEKKO", logo: "https://tekkoperu.com/wp-content/uploads/2020/12/tekko-transparente-1024x278.png" }, 
];
---

<section class="bg-white pb-16 pt-8">
  <div class="mx-auto max-w-6xl px-6">

    <!-- Encabezado -->
    <h2 class="flex items-center gap-3 text-2xl font-extrabold text-yeledarkblue">
      <span class="h-0.5 w-9 bg-yeleorange"></span>
      Algunos de nuestros clientes
    </h2>

    <!-- Logos -->
    <ul class="mt-8 grid grid-cols-2 items-center gap-5 sm:grid-cols-3 md:grid-cols-4">
      {customers.map((customer) => (
        <li
          class="flex h-24 items-center justify-center rounded-xl border border-slate-100 bg-white p-4 transition duration-300 hover:-translate-y-1 hover:shadow-md"
          title={customer.name}
        >
          {customer.logo ? (
            <img
              src={customer.logo}
              alt={`Logo de ${customer.name}`}
              loading="lazy"
              class="max-h-full max-w-full object-contain"
            />
          ) : (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user preview-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>