---
const allies: { name: string; logo: string | null }[] = [
  { name: "Schneider", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQTWs-TSa6PEHi0PwRmjDYq3pE4-G5czJIAkCzuC6F7Rw&s=10" },
  { name: "Opalux", logo: "https://electrocespedes.com/wp-content/uploads/2025/03/t_marcas_opalux_6ff1c6.png" },
  { name: "Bosch", logo: "https://1000logos.net/wp-content/uploads/2016/10/Bosch-Logo-2001.png" },
  { name: "Philips", logo: "https://brandlogos.net/wp-content/uploads/2015/03/philips-logo_brandlogos.net_nixii.png" },
  { name: "Honeywell", logo: "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/Honeywell_logo.svg/1280px-Honeywell_logo.svg.png?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=thumbnail" },
  { name: "Siemens", logo: "https://download.logo.wine/logo/Siemens/Siemens-Logo.wine.png" },
  { name: "Panduit", logo: "https://cdn11.bigcommerce.com/s-ko96ce4of8/images/stencil/1280x1280/products/248924/473710/panduit__37808.1747189664.png?c=2" },
  { name: "Indeco", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQz4Iq--78_iGoxnAN9Z3nW8hI1Bnfw9uOY3FCSCMOARA&s=10" },
  { name: "Hikvision", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT4k9w1k7O3ub6o_-Kl_5ygrtmT1jq5AYIf9999ZJ-yvw&s=10" },
  { name: "Celsa", logo: "https://images.squarespace-cdn.com/content/v1/5e289ba3e0378e73cb895f73/4b64fa44-af45-4297-982c-9b17315abee7/CELSA.png?format=500w" },
];
---

<section class="bg-yelewhiteblue pb-16 pt-8">
  <div class="mx-auto max-w-6xl px-6">

    <!-- Encabezado -->
    <h2 class="flex items-center gap-3 text-2xl font-extrabold text-yeledarkblue">
      <span class="h-0.5 w-9 bg-yeleorange"></span>
      Aliados
    </h2>

    <!-- Logos -->
    <ul class="mt-8 grid grid-cols-2 items-center gap-5 sm:grid-cols-3 md:grid-cols-5">
      {allies.map((ally) => (
        <li
          class="flex h-24 items-center justify-center rounded-xl border border-slate-100 bg-white p-4 transition duration-300 hover:-translate-y-1 hover:shadow-md"
          title={ally.name}
        >
          {ally.logo ? (
            <img
              src={ally.logo}
              alt={`Logo de ${ally.name}`}
              loading="lazy"
              class="max-h-full max-w-full object-contain"
            />
          ) : (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user preview-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          )}
        </li>
      ))}
    </ul>

    <!-- Botón de contacto -->
    <div class="mt-12 flex justify-center">
      <a href="/contact" class="inline-flex items-center gap-3 rounded-lg bg-yeleorange px-10 py-3.5 text-[15px] font-semibold text-white shadow-md transition hover:bg-yeledarkorange">
        <!--calendario -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-1 preview-icon"><path d="M11 13h1v4"/><path d="M16 2v3"/><path d="M3 9h18"/><path d="M8 2v3"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
        Agendar visita
        <!--flecha-->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right preview-icon"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>