---
const sessionCookie = Astro.cookies.get('yele_session')?.value;
let userSession: any = null;
if (sessionCookie) {
  try {
    userSession = JSON.parse(decodeURIComponent(sessionCookie));
  } catch {}
}
/* ─────────────────────────────────────────────
   ICONOS LUCIDE
───────────────────────────────────────────── */

const paths: Record<string, string> = {
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
  calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  send: '<path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  left: '<path d="m15 18-6-6 6-6"/>',
  right: '<path d="m9 18 6-6-6-6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  zap: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
};

const icon = (name: string, cls = 'h-5 w-5') =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${cls}" aria-hidden="true">${paths[name] ?? ''}</svg>`;


/* ─────────────────────────────────────────────
   ESTILOS
───────────────────────────────────────────── */

const input =
  'w-full rounded-lg border border-sky-200 bg-white py-3 pl-12 pr-4 text-sm text-navy-900 placeholder:text-slate-400 transition focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 data-[touched=true]:invalid:border-red-400';

const label =
  'mb-2 block text-sm font-semibold text-navy-800';

const iconBox =
  'pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-navy-700';


/* ─────────────────────────────────────────────
   CAMPOS DEL FORMULARIO
───────────────────────────────────────────── */

type PersonalField = {
  id: string;
  label: string;
  type: 'text' | 'email' | 'tel';
  ph: string;
  icon: string;
  ac: string;
  pattern?: string;
  title?: string;
  maxlength?: number;
  inputmode?: 'numeric' | 'email' | 'text';
};

const personal: PersonalField[] = [
  {
    id: 'nombres',
    label: 'Nombres',
    type: 'text',
    ph: 'Ej. Juan Pérez',
    icon: 'user',
    ac: 'given-name',
    maxlength: 80,
  },
  {
    id: 'apellidos',
    label: 'Apellidos',
    type: 'text',
    ph: 'Ej. García López',
    icon: 'user',
    ac: 'family-name',
    maxlength: 80,
  },
  {
    id: 'correo',
    label: 'Correo',
    type: 'email',
    ph: 'ejemplo@correo.com',
    icon: 'mail',
    ac: 'email',
    // exige usuario@dominio.ext (no deja pasar "juan@gmail")
    pattern: '[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}',
    title: 'Ingresa un correo válido, por ejemplo nombre@correo.com',
    maxlength: 150,
    inputmode: 'email',
  },
  {
    id: 'telefono',
    label: 'Teléfono',
    type: 'tel',
    ph: '987654321',
    icon: 'phone',
    ac: 'tel',
    // celular peruano: 9 dígitos y empieza con 9
    pattern: '9[0-9]{8}',
    title: 'Ingresa un celular de 9 dígitos que empiece con 9',
    maxlength: 9,
    inputmode: 'numeric',
  },
];

const tipos = [
  'Visita técnica presencial',
  'Cotización en sitio',
  'Asesoría virtual',
];

const motivos = [
  'Instalación eléctrica',
  'Mantenimiento preventivo o correctivo',
  'Tableros eléctricos',
  'Iluminación LED',
  'Proyecto eléctrico',
  'Solución industrial',
  'Otro',
];
---


<!-- ═══════════════════════════════════════════
     HERO
═══════════════════════════════════════════ -->



<!-- ═══════════════════════════════════════════
     FORMULARIO
═══════════════════════════════════════════ -->

<section class="bg-yelewhiteblue px-4 py-10 sm:px-6">

  <div class="mx-auto max-w-4xl rounded-2xl bg-white p-6 shadow-[0_10px_40px_rgba(15,58,102,0.08)] sm:p-9">

    <h2 class="flex items-center gap-4 text-3xl font-extrabold text-yeleblue">
      <span class="h-0.5 w-9 bg-yeleorange"></span>
      Agenda tu visita
    </h2>


    <form id="agenda-form" novalidate class="relative mt-6">

      <!-- VALORES SELECCIONADOS -->

      <input type="hidden" name="fecha" id="fecha" />
      <input type="hidden" name="hora" id="hora" />

      <!-- HONEYPOT anti-spam: las personas no lo ven, los bots lo rellenan -->
      <input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        class="absolute left-[-9999px] h-0 w-0 opacity-0"
      />

      <!-- ═══════════════════════════════════════
           PASO 1
      ═══════════════════════════════════════ -->

      <div>

        <h3 class="flex items-center gap-3 text-lg font-bold text-yeleblue">

          <span
            id="badge-1"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-yeleorange text-xs text-white"
          >
            1
          </span>

          Elige la fecha y hora de tu visita

        </h3>


        <div class="mt-5 grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">

          <!-- CALENDARIO -->

          <div class="rounded-xl border border-sky-200 p-4">

            <div class="mb-3 flex items-center justify-between">

              <button
                type="button"
                id="cal-prev"
                aria-label="Mes anterior"
                class="rounded-lg p-2 text-yeleblue transition hover:bg-yelewhiteorange disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-transparent"
              >
                <span set:html={icon('left')}></span>
              </button>

              <p
                id="cal-title"
                class="text-sm font-bold capitalize text-yeleblue"
              ></p>

              <button
                type="button"
                id="cal-next"
                aria-label="Mes siguiente"
                class="rounded-lg p-2 text-yeleblue transition hover:bg-yelewhiteorange disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-transparent"
              >
                <span set:html={icon('right')}></span>
              </button>

            </div>


            <div class="grid grid-cols-7 gap-1 text-center text-[11px] font-semibold uppercase text-slate-400">
              <span>L</span>
              <span>M</span>
              <span>M</span>
              <span>J</span>
              <span>V</span>
              <span>S</span>
              <span>D</span>
            </div>


            <div
              id="cal-grid"
              class="mt-1 grid grid-cols-7 gap-1"
            ></div>


            <p class="mt-3 text-[11px] text-slate-400">
              Lunes a viernes: 3 horarios por día. Sábados: 2 horarios.
              Reserva con al menos 1 día de anticipación.
            </p>

          </div>


          <!-- HORARIOS -->

          <div class="rounded-xl border border-sky-200 p-4">

            <p class="mb-3 flex items-center gap-2 text-sm font-bold text-yeleblue">

              <span set:html={icon('clock', 'h-4 w-4 text-yeleorange')}></span>

              <span id="slots-title">
                Horarios disponibles
              </span>

            </p>


            <p id="slots-empty" class="text-sm text-slate-400">
              Primero selecciona un día en el calendario.
            </p>


            <div
              id="slots-grid"
              class="hidden grid-cols-3 gap-2"
            ></div>


            <div
              id="no-slots"
              class="hidden rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-700"
            >
              No hay horarios disponibles para este día.
              Selecciona otra fecha.
            </div>

          </div>

        </div>


        <!-- RESUMEN -->

        <p
          id="resumen"
          class="mt-4 hidden items-center gap-2 rounded-lg bg-yelewhiteorange px-4 py-3 text-sm font-semibold text-yeleblue"
        >

          <span set:html={icon('check', 'h-4 w-4 text-yeleorange')}></span>

          <span id="resumen-text"></span>

        </p>

      </div>


      <!-- ═══════════════════════════════════════
           PASO 2
      ═══════════════════════════════════════ -->

      <fieldset
        id="paso-2"
        disabled
        class="mt-10 opacity-50 transition-opacity duration-300"
      >

        <legend class="mb-1 flex items-center gap-3 text-lg font-bold text-yeleblue">

          <span
            id="badge-2"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-300 text-xs text-white transition-colors"
          >
            2
          </span>

          Ingresa tus datos

        </legend>


        <p id="paso-2-hint" class="mb-5 ml-10 text-sm text-slate-500">
          Selecciona una fecha y hora para continuar.
        </p>


        <div class="grid gap-x-7 gap-y-5 md:grid-cols-2">

          {
            personal.map((f) => (
              <div>

                <label for={f.id} class={label}>
                  {f.label} *
                </label>

                <div class="relative">

                  <span
                    class={iconBox}
                    set:html={icon(f.icon)}
                  ></span>

                  <input
                    id={f.id}
                    name={f.id}
                    type={f.type}
                    required
                    autocomplete={f.ac}
                    placeholder={f.ph}
                    pattern={f.pattern}
                    title={f.title}
                    maxlength={f.maxlength}
                    inputmode={f.inputmode}
                    value={
                      f.id === 'nombres' ? (userSession?.nombres || '') :
                      f.id === 'apellidos' ? (userSession?.apellidos || '') :
                      f.id === 'correo' ? (userSession?.email || '') :
                      f.id === 'telefono' ? (userSession?.telefono || '') : ''
                    }
                    class={input}
                  />

                </div>

              </div>
            ))
          }


          <!-- DIRECCIÓN -->

          <div class="md:col-span-2">

            <label for="direccion" class={label}>
              Dirección *
            </label>

            <div class="relative">

              <span class={iconBox} set:html={icon('pin')}></span>

              <input
                id="direccion"
                name="direccion"
                type="text"
                required
                minlength="5"
                maxlength="200"
                autocomplete="street-address"
                placeholder="Ej. Av. Principal 123, Lima"
                class={input}
              />

            </div>

          </div>


          <!-- TIPO -->

          <div class="md:col-span-2">

            <label for="tipo" class={label}>
              Tipo de visita *
            </label>

            <div class="relative">

              <span class={iconBox} set:html={icon('calendar')}></span>

              <select
                id="tipo"
                name="tipo"
                required
                class={`${input} appearance-none invalid:text-slate-400`}
              >

                <option value="" disabled selected>
                  Selecciona un tipo de visita
                </option>

                {
                  tipos.map((t) => (
                    <option value={t} class="text-navy-900">
                      {t}
                    </option>
                  ))
                }

              </select>

              <span
                class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-yeleblue"
                set:html={icon('chevron')}
              ></span>

            </div>

          </div>


          <!-- MOTIVO -->

          <div class="md:col-span-2">

            <label for="motivo" class={label}>
              Selecciona el motivo de la visita *
            </label>

            <div class="relative">

              <span class={iconBox} set:html={icon('shield')}></span>

              <select
                id="motivo"
                name="motivo"
                required
                class={`${input} appearance-none invalid:text-slate-400`}
              >

                <option value="" disabled selected>
                  Selecciona una opción
                </option>

                {
                  motivos.map((m) => (
                    <option value={m} class="text-yeledarkblue">
                      {m}
                    </option>
                  ))
                }

              </select>

              <span
                class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-yeleblue"
                set:html={icon('chevron')}
              ></span>

            </div>

          </div>


          <!-- DETALLES -->

          <div class="md:col-span-2">

            <label for="detalles" class={label}>
              Detalles de la visita *
            </label>

            <div class="relative">

              <span
                class="pointer-events-none absolute left-4 top-4 text-yelelightblue"
                set:html={icon('message')}
              ></span>

              <textarea
                id="detalles"
                name="detalles"
                rows="4"
                required
                minlength="10"
                maxlength="1000"
                placeholder="Cuéntanos más sobre tu proyecto, requerimientos o alguna observación adicional..."
                class={`${input} resize-y`}
              ></textarea>

            </div>

          </div>

        </div>

      </fieldset>


      <!-- ERROR -->

      <p
        id="form-error"
        class="mt-6 hidden rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"
        role="alert"
      ></p>


      <!-- BOTÓN -->

      <div class="mt-8 flex justify-center">

        <button
          id="btn-enviar"
          type="submit"
          disabled
          class="inline-flex min-w-64 cursor-pointer items-center justify-center gap-3 rounded-lg bg-yeleorange px-10 py-3.5 text-base font-semibold text-white shadow-md transition hover:bg-yelelightorange disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none"
        >

          <span set:html={icon('send')}></span>

          <span id="btn-text">
            Enviar solicitud
          </span>

        </button>

      </div>

    </form>


    <!-- ═══════════════════════════════════════
         ÉXITO
    ═══════════════════════════════════════ -->

    <div
      id="exito"
      class="hidden py-10 text-center"
      aria-live="polite"
    >

      <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-yelewhiteorange text-yeleorange">

        <span set:html={icon('check', 'h-8 w-8')}></span>

      </span>


      <h3 class="mt-5 text-2xl font-extrabold text-yeleblue">
        ¡Solicitud enviada!
      </h3>


      <p class="mx-auto mt-2 max-w-md text-slate-500">

        Hemos registrado tu solicitud de visita para

        <strong id="exito-fecha" class="text-yeleblue"></strong>.

        Un especialista se pondrá en contacto contigo para confirmar la visita.

      </p>


      <div class="mx-auto mt-5 max-w-md rounded-lg bg-yelewhiteorange px-4 py-3 text-sm text-yeleblue">

        <strong>Solicitud registrada correctamente.</strong>

        <br />

        Te contactaremos para confirmar los detalles de la visita.

      </div>


      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/portal"
          class="inline-flex items-center gap-2 rounded-lg bg-yeleorange hover:bg-yeledarkorange px-6 py-2.5 text-sm font-bold text-white shadow-sm transition"
        >
          Ir a Mi Portal de Trámites
        </a>
        <a
          href="/contact"
          class="inline-flex rounded-lg border border-slate-300 px-6 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-100 transition"
        >
          Agendar otra visita
        </a>
      </div>

    </div>

  </div>

</section>


<script>

  // ═════════════════════════════════════════════
  // CONFIGURACIÓN
  // ═════════════════════════════════════════════

  // Horarios por día de la semana (0 = domingo ... 6 = sábado)
  const HORARIOS_POR_DIA: Record<number, string[]> = {
    1: ['08:00', '12:00', '16:00'],
    2: ['08:00', '12:00', '16:00'],
    3: ['08:00', '12:00', '16:00'],
    4: ['08:00', '12:00', '16:00'],
    5: ['08:00', '12:00', '16:00'],
    6: ['08:00', '12:00'],
  };

  const MAX_DAYS_AHEAD = 60;

  const CLOSED_DAYS = [0];


  // ═════════════════════════════════════════════
  // ELEMENTOS
  // ═════════════════════════════════════════════

  const $ = (id: string) =>
    document.getElementById(id)!;

  const form =
    $('agenda-form') as HTMLFormElement;

  const grid =
    $('cal-grid');

  const title =
    $('cal-title');

  const prev =
    $('cal-prev') as HTMLButtonElement;

  const next =
    $('cal-next') as HTMLButtonElement;

  const slotsGrid =
    $('slots-grid');

  const slotsEmpty =
    $('slots-empty');

  const slotsTitle =
    $('slots-title');

  const noSlots =
    $('no-slots');

  const resumen =
    $('resumen');

  const resumenText =
    $('resumen-text');

  const paso2 =
    $('paso-2') as HTMLFieldSetElement;

  const hint =
    $('paso-2-hint');

  const badge2 =
    $('badge-2');

  const btn =
    $('btn-enviar') as HTMLButtonElement;

  const btnText =
    $('btn-text');

  const errorBox =
    $('form-error');

  const fechaInput =
    $('fecha') as HTMLInputElement;

  const horaInput =
    $('hora') as HTMLInputElement;

  const telInput =
    $('telefono') as HTMLInputElement;


  // ═════════════════════════════════════════════
  // TELÉFONO:
  // ═════════════════════════════════════════════

  telInput.addEventListener(
    'input',
    () => {

      telInput.value =
        telInput.value
          .replace(/\D/g, '')
          .slice(0, 9);

    }
  );


  // ═════════════════════════════════════════════
  // ESTADO
  // ═════════════════════════════════════════════

  const startOfDay = (d: Date) =>
    new Date(
      d.getFullYear(),
      d.getMonth(),
      d.getDate()
    );

  const minDate =
    startOfDay(new Date());

  minDate.setDate(
    minDate.getDate() + 1
  );

  const maxDate =
    new Date(minDate);

  maxDate.setDate(
    maxDate.getDate() + MAX_DAYS_AHEAD
  );

  let view =
    new Date(
      minDate.getFullYear(),
      minDate.getMonth(),
      1
    );

  let selDate: Date | null = null;

  let selTime: string | null = null;
  let occupiedSlots: string[] = [];
  let loadingSlots = false;


  // ═════════════════════════════════════════════
  // UTILIDADES
  // ═════════════════════════════════════════════

  const iso = (d: Date) =>
    `${d.getFullYear()}-${String(
      d.getMonth() + 1
    ).padStart(2, '0')}-${String(
      d.getDate()
    ).padStart(2, '0')}`;

  const longDate = (d: Date) =>
    new Intl.DateTimeFormat(
      'es-PE',
      {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
      }
    ).format(d);




  function getAvailableSlots(date: Date): string[] {

    return [
      ...(HORARIOS_POR_DIA[date.getDay()] ?? []),
    ];

  }


  // ═════════════════════════════════════════════
  // CALENDARIO
  // ═════════════════════════════════════════════

  function renderCalendar() {

    title.textContent =
      new Intl.DateTimeFormat(
        'es-PE',
        {
          month: 'long',
          year: 'numeric',
        }
      ).format(view);

    prev.disabled =
      view <=
      new Date(
        minDate.getFullYear(),
        minDate.getMonth(),
        1
      );

    next.disabled =
      view >=
      new Date(
        maxDate.getFullYear(),
        maxDate.getMonth(),
        1
      );

    const first =
      new Date(
        view.getFullYear(),
        view.getMonth(),
        1
      );

    const days =
      new Date(
        view.getFullYear(),
        view.getMonth() + 1,
        0
      ).getDate();

    const offset =
      (first.getDay() + 6) % 7;

    grid.innerHTML = '';

    for (
      let i = 0;
      i < offset;
      i++
    ) {
      grid.appendChild(
        document.createElement('span')
      );
    }

    for (
      let day = 1;
      day <= days;
      day++
    ) {

      const date =
        new Date(
          view.getFullYear(),
          view.getMonth(),
          day
        );

      const disabled =
        date < minDate ||
        date > maxDate ||
        CLOSED_DAYS.includes(
          date.getDay()
        );

      const selected =
        selDate &&
        iso(selDate) === iso(date);

      const b =
        document.createElement('button');

      b.type = 'button';

      b.textContent =
        String(day);

      b.disabled =
        disabled;

      b.setAttribute(
        'aria-pressed',
        String(!!selected)
      );

      b.className =
        'h-10 w-full rounded-lg text-sm font-medium transition ' +
        (
          disabled
            ? 'cursor-not-allowed text-slate-300'
            : selected
              ? 'bg-brand-500 font-bold text-white'
              : 'text-navy-800 hover:bg-brand-50'
        );

      if (!disabled) {
        b.addEventListener(
          'click',
          () => selectDate(date)
        );
      }

      grid.appendChild(b);
    }
  }


  // ═════════════════════════════════════════════
  // CAMBIO DE MES
  // ═════════════════════════════════════════════

  prev.addEventListener(
    'click',
    () => {

      view =
        new Date(
          view.getFullYear(),
          view.getMonth() - 1,
          1
        );

      renderCalendar();

    }
  );

  next.addEventListener(
    'click',
    () => {

      view =
        new Date(
          view.getFullYear(),
          view.getMonth() + 1,
          1
        );

      renderCalendar();

    }
  );


  // ═════════════════════════════════════════════
  // SELECCIONAR FECHA
  // ═════════════════════════════════════════════

    async function selectDate(date: Date) {
    selDate = date;
    selTime = null;
    occupiedSlots = [];
    loadingSlots = true;

    renderCalendar();
    renderSlots();
    updateState();

    try {
      const res = await fetch(`/api/horarios-ocupados?fecha=${iso(date)}`);
      if (res.ok) {
        const data = await res.json();
        occupiedSlots = data.ocupados || [];
      }
    } catch (err) {
      console.error('Error al consultar horarios ocupados:', err);
    } finally {
      loadingSlots = false;
      renderSlots();
      updateState();
    }
  }

  function renderSlots() {
    if (!selDate) {
      return;
    }

    const availableSlots = getAvailableSlots(selDate);

    slotsEmpty.classList.add('hidden');
    noSlots.classList.add('hidden');
    slotsGrid.classList.remove('hidden');
    slotsGrid.classList.add('grid');

    slotsTitle.textContent = `Horarios para el ${longDate(selDate)}`;
    slotsGrid.innerHTML = '';

    if (availableSlots.length === 0) {
      slotsGrid.classList.add('hidden');
      slotsGrid.classList.remove('grid');
      noSlots.textContent = 'No hay horarios disponibles para este día. Selecciona otra fecha.';
      noSlots.classList.remove('hidden');
      selTime = null;
      updateState();
      return;
    }

    if (loadingSlots) {
      slotsGrid.innerHTML = `
        <div class="col-span-full py-4 text-center text-xs text-slate-500 flex items-center justify-center gap-2">
          <div class="h-3 w-3 animate-spin rounded-full border-2 border-brand-500 border-t-transparent"></div>
          Verificando horarios disponibles...
        </div>
      `;
      return;
    }

    const freeSlots = availableSlots.filter(t => !occupiedSlots.includes(t));
    if (freeSlots.length === 0) {
      slotsGrid.classList.add('hidden');
      slotsGrid.classList.remove('grid');
      noSlots.textContent = 'Todos los horarios para esta fecha están ocupados. Por favor selecciona otro día en el calendario.';
      noSlots.classList.remove('hidden');
      selTime = null;
      updateState();
      return;
    }

    availableSlots.forEach((time) => {
      const isOccupied = occupiedSlots.includes(time);
      const b = document.createElement('button');
      b.type = 'button';

      if (isOccupied) {
        b.disabled = true;
        b.title = 'Este horario ya ha sido reservado.';
        b.className = 'rounded-lg border border-slate-200 bg-slate-100 text-slate-400 cursor-not-allowed py-2.5 px-3 text-xs font-semibold flex items-center justify-between opacity-60';
        b.innerHTML = `<span class="line-through">${time}</span><span class="text-[9px] uppercase tracking-wider font-bold bg-red-100 text-red-600 px-1.5 py-0.5 rounded">Ocupado</span>`;
      } else {
        b.textContent = time;
        b.setAttribute('aria-pressed', String(selTime === time));
        b.className =
          'rounded-lg border py-2.5 text-sm font-semibold transition cursor-pointer ' +
          (selTime === time
            ? 'border-brand-500 bg-brand-500 text-white shadow-sm'
            : 'border-sky-200 text-navy-800 hover:border-brand-500 hover:text-brand-500 hover:bg-sky-50/50');

        b.addEventListener('click', () => {
          selTime = time;
          renderSlots();
          updateState();
        });
      }

      slotsGrid.appendChild(b);
    });
  }

  function updateState() {

    const ready =
      !!(
        selDate &&
        selTime
      );

    fechaInput.value =
      selDate
        ? iso(selDate)
        : '';

    horaInput.value =
      selTime ?? '';

    if (ready) {

      resumen.classList.remove('hidden');

      resumen.classList.add('flex');

      resumenText.textContent =
        `Visita: ${longDate(selDate!)} a las ${selTime}`;

    } else {

      resumen.classList.add('hidden');

      resumen.classList.remove('flex');

    }

    paso2.disabled =
      !ready;

    paso2.classList.toggle(
      'opacity-50',
      !ready
    );

    badge2.classList.toggle(
      'bg-brand-500',
      ready
    );

    badge2.classList.toggle(
      'bg-slate-300',
      !ready
    );

    hint.textContent =
      ready
        ? 'Completa todos los campos para poder enviar la solicitud.'
        : selDate
          ? 'Ahora elige una hora para continuar.'
          : 'Selecciona una fecha y hora para continuar.';

    btn.disabled =
      !(
        ready &&
        form.checkValidity()
      );

  }


  // ═════════════════════════════════════════════
  // VALIDACIÓN EN VIVO
  // ═════════════════════════════════════════════

  form.addEventListener(
    'input',
    updateState
  );

  form.addEventListener(
    'change',
    updateState
  );

  form.addEventListener(
    'blur',
    (e) => {

      const el =
        e.target as HTMLElement;

      if (
        el.matches(
          'input, select, textarea'
        )
      ) {

        (el as HTMLElement).dataset.touched =
          'true';

        updateState();

      }

    },
    true
  );


  // ═════════════════════════════════════════════
  // ENVÍO AL SERVIDOR
  // ═════════════════════════════════════════════

  form.addEventListener(
    'submit',
    async (e) => {

      e.preventDefault();

      errorBox.classList.add('hidden');

      if (!selDate || !selTime) {
        errorBox.textContent = 'Selecciona una fecha y una hora antes de continuar.';
        errorBox.classList.remove('hidden');
        return;
      }

      const telVal = (document.getElementById('telefono') as HTMLInputElement)?.value.trim() || '';
      if (!/^9\d{8}$/.test(telVal)) {
        errorBox.textContent = 'El teléfono debe ser un celular peruano válido de 9 dígitos y empezar con 9.';
        errorBox.classList.remove('hidden');
        (document.getElementById('telefono') as HTMLInputElement)?.focus();
        return;
      }

      if (!form.checkValidity()) {

        form
          .querySelectorAll<HTMLElement>(
            'input, select, textarea'
          )
          .forEach(
            (el) => {
              el.dataset.touched = 'true';
            }
          );

        errorBox.textContent =
          'Revisa los campos obligatorios antes de enviar tu solicitud.';

        errorBox.classList.remove('hidden');

        form.reportValidity();

        return;
      }

      btn.disabled = true;

      btnText.textContent = 'Enviando...';

      try {

        const res =
          await fetch(
            '/api/agendar',
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(
                Object.fromEntries(
                  new FormData(form)
                )
              ),
            }
          );

        const data =
          await res
            .json()
            .catch(() => ({}));

        if (!res.ok) {

          if (res.status === 409) {
            selTime = null;
            renderSlots();
          }

          const primerError =
            data.errores
              ? Object.values(data.errores).flat()[0]
              : null;

          throw new Error(
            (primerError as string) ||
            data.error ||
            'No pudimos procesar tu solicitud. Inténtalo nuevamente.'
          );
        }

        form.classList.add('hidden');

        $('exito-fecha').textContent =
          `${longDate(selDate)} a las ${selTime}`;

        $('exito').classList.remove('hidden');

        $('exito').scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        });

      } catch (error) {

        errorBox.textContent =
          error instanceof Error
            ? error.message
            : 'No pudimos procesar tu solicitud. Inténtalo nuevamente.';

        errorBox.classList.remove('hidden');

        btnText.textContent =
          'Enviar solicitud';

        updateState();

      }

    }
  );


  renderCalendar();

  updateState();

</script>