        <div id="admin-chat-messages" class="flex-1 p-4 space-y-3 overflow-y-auto bg-slate-50/50 text-xs min-h-[220px]">
          <!-- mensajes -->
        </div>

        <form id="admin-chat-form" class="p-3 bg-white border-t border-slate-100 flex items-center gap-2 rounded-b-3xl">
          <input type="hidden" id="admin-chat-solicitud-id" />
          <input 
            type="text" 
            id="admin-chat-input"
            required 
            placeholder="Escribe una respuesta o aviso al cliente..." 
            class="flex-1 px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-yeleblue"
          />
          <button 
            type="submit" 
            class="px-4 py-2 bg-yeleblue hover:bg-yeledarkblue text-white text-xs font-bold rounded-xl transition cursor-pointer"
          >
            Enviar
          </button>
