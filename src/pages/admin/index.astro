              <span>Trabajo Sugerido / Realizado en Sitio</span>
            </h4>
            <div id="detail-trabajo" class="p-3.5 bg-blue-50/50 rounded-xl border border-blue-100 text-slate-700 leading-relaxed font-medium">
              --
            </div>
          </div>

          <!-- Materiales Requeridos -->
          <div>
            <h4 class="font-bold text-slate-700 uppercase tracking-wider text-[11px] mb-1.5 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
              </svg>
              <span>Materiales y Repuestos Solicitados por el Técnico</span>
            </h4>
            <div id="detail-materiales-container" class="border border-slate-200 rounded-xl overflow-hidden">
              <!-- Tabla de materiales -->
            </div>
