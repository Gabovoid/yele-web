          <!-- Observaciones / Recomendaciones -->
          <div>
            <h4 class="font-bold text-slate-700 uppercase tracking-wider text-[11px] mb-1.5 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
              </svg>
              <span>Recomendaciones y Observaciones Finales</span>
            </h4>
            <div id="detail-observaciones" class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-slate-600 italic">
              --
