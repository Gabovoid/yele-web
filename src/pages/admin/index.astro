            <p class="text-xs text-slate-500" id="admin-chat-title">Trámite #--</p>
          </div>
          <button type="button" id="close-admin-chat" class="p-1.5 text-slate-400 hover:text-slate-700 rounded-xl hover:bg-slate-200/50 transition cursor-pointer">
            ✕
          </button>
