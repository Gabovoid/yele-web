---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Panel de Gerencia | YELE S.A.C.">
  <div class="min-h-screen bg-yelewhiteblue text-slate-700 pb-16">
    
    <!-- Topbar Corporativo -->
    <header class="bg-yeledarkblue text-white shadow-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-xl bg-yeleorange flex items-center justify-center font-bold text-white shadow-sm">
            Y
          </div>
          <div>
            <h1 class="text-base font-bold leading-none tracking-tight text-white">Panel de Gerencia & Operaciones</h1>
            <span class="text-xs text-orange-200">YELE S.A.C. — Gestión Central</span>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="text-right hidden sm:block">
            <p id="admin-user-name" class="text-xs font-semibold text-white">Cargando perfil...</p>
            <span class="inline-block px-2 py-0.5 text-[10px] bg-yelelightblue text-white rounded-full font-medium">
              Rol: Gerencia / Administrador
            </span>
          </div>

          <button
            type="button"
            id="logout-btn"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-white/10 hover:bg-white/20 text-white transition flex items-center gap-1.5 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Salir
          </button>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
      
      <!-- Resumen Ejecutivo (KPIs con botón de acción) -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Citas Pendientes</p>
            <h3 id="stat-pending" class="text-2xl font-bold text-yeledarkblue mt-1">--</h3>
          </div>
          <div class="h-12 w-12 rounded-xl bg-yelewhiteorange text-yeleorange flex items-center justify-center font-bold">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Técnicos en Equipo</p>
            <h3 id="stat-techs" class="text-2xl font-bold text-yeledarkblue mt-1">--</h3>
          </div>
          <div class="h-12 w-12 rounded-xl bg-yelewhiteblue text-yeleblue flex items-center justify-center font-bold">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Informes por Evaluar</p>
            <h3 id="stat-reports" class="text-2xl font-bold text-yeledarkblue mt-1">--</h3>
          </div>
          <div class="h-12 w-12 rounded-xl bg-orange-100 text-yeledarkorange flex items-center justify-center font-bold">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Cotizaciones Aprobadas</p>
            <h3 id="stat-quotes" class="text-2xl font-bold text-emerald-600 mt-1">S/. 0.00</h3>
            <p id="stat-quotes-sub" class="text-[11px] text-slate-400 mt-0.5">0 aprobadas por clientes</p>
          </div>
          <div class="h-12 w-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
        </div>
      </section>

      <!-- SECCIÓN EQUIPO DE TÉCNICOS & BOTÓN REGISTRAR TÉCNICO -->
      <section class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
          <div>
            <h2 class="text-lg font-bold text-yeledarkblue flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yeleblue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
              Equipo de Técnicos Autorizados
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">
              Personal operativo habilitado para atender citas y redactar informes de campo.
            </p>
          </div>

          <button
            type="button"
            id="open-tech-modal-btn"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-yeleorange hover:bg-yeledarkorange shadow-md shadow-yeleorange/20 transition cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            + Registrar Nuevo Técnico
          </button>
        </div>

        <!-- Grid de Técnicos -->
        <div id="technicians-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="p-4 text-center text-xs text-slate-400 col-span-full">Cargando personal técnico...</div>
        </div>
      </section>

      <!-- SECCIÓN 2: ASIGNACIÓN DE TÉCNICOS A SOLICITUDES DE CLIENTES -->
      <section class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
          <div>
            <h2 class="text-lg font-bold text-yeledarkblue flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-yeleorange"></span>
              Citas y Solicitudes de Clientes
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">
              Asigna técnicos calificados según fecha, hora y ubicación de la visita solicitada.
            </p>
          </div>


        </div>

        <!-- Tabla de Solicitudes -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                <th class="py-3 px-4 font-semibold">ID / Fecha</th>
                <th class="py-3 px-4 font-semibold">Cliente</th>
                <th class="py-3 px-4 font-semibold">Tipo / Motivo</th>
                <th class="py-3 px-4 font-semibold">Dirección</th>
                <th class="py-3 px-4 font-semibold text-center min-w-[170px]">Estado</th>
                <th class="py-3 px-4 font-semibold text-right">Técnico Asignado</th>
              </tr>
            </thead>
            <tbody id="solicitudes-table-body" class="divide-y divide-slate-100">
              <tr>
                <td colspan="6" class="text-center py-8 text-slate-400">
                  <div class="animate-spin inline-block h-6 w-6 border-2 border-yeleblue border-t-transparent rounded-full mb-2"></div>
                  <p class="text-xs">Cargando solicitudes...</p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- SECCIÓN 3: EVALUACIÓN DE INFORMES Y COTIZADOR MANUAL -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Lista de Informes Técnicos Recibidos -->
        <div class="lg:col-span-5 bg-white rounded-3xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-base font-bold text-yeledarkblue flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yeleblue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                </svg>
                Informes Técnicos Recientes
              </h2>
              <span id="informes-count-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-yelewhiteorange text-yeleorange">
                0
              </span>
            </div>
            <p class="text-xs text-slate-500 mb-4">
              Expedientes enviados desde campo por los técnicos. Abre el informe completo para revisar el diagnóstico o cotiza manualmente.
            </p>

            <div id="informes-list" class="space-y-3 max-h-[640px] overflow-y-auto pr-1">
              <div class="p-4 rounded-2xl bg-yelewhiteblue border border-slate-100 text-xs text-slate-500 text-center">
                No hay informes pendientes de evaluación.
              </div>
            </div>
          </div>
        </div>

        <!-- Módulo de Cotización 100% MANUAL para Gerencia -->
        <div id="cotizador-manual-container" class="lg:col-span-7 bg-white rounded-3xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between space-y-6">
          <div class="space-y-5">
            <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-100">
              <div>
                <h2 class="text-base font-bold text-yeledarkblue flex items-center gap-2">
                  <span class="p-1.5 rounded-lg bg-yelewhiteorange text-yeleorange font-bold text-xs">
                    Cotización 100% Manual
                  </span>
                  Elaboración de Presupuesto Formal
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                  Redacta y desglosa libremente las partidas, insumos y costos que se enviarán al cliente.
                </p>
              </div>
              <span id="manual-solicitud-badge" class="text-xs font-bold text-yeleblue bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-100">
                Selecciona una Cita / Informe
              </span>
            </div>

            <!-- Selector de Solicitud/Cita a cotizar -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs bg-slate-50 p-4 rounded-2xl border border-slate-200">
              <div>
                <label for="manual-solicitud-select" class="block font-semibold text-slate-700 mb-1">Cita / Solicitud a Cotizar *</label>
                <select id="manual-solicitud-select" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 font-semibold text-slate-800 focus:ring-2 focus:ring-yeleblue focus:outline-none">
                  <option value="">-- Elige una cita de la lista --</option>
                </select>
              </div>
              <div>
                <label for="manual-quote-code" class="block font-semibold text-slate-700 mb-1">Código de Cotización</label>
                <input type="text" id="manual-quote-code" value="COT-2026-XXXX" readonly class="w-full bg-white border border-slate-200 rounded-xl p-2.5 font-mono font-bold text-yeledarkblue" />
              </div>
              <div class="sm:col-span-2 text-[11px] text-slate-500 flex flex-wrap items-center justify-between gap-2 px-1">
                <span id="manual-client-info">Cliente: Selecciona una solicitud arriba para ver sus datos</span>
                <span id="manual-informe-tag" class="hidden text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">✓ Con informe técnico vinculado</span>
              </div>
            </div>

            <!-- Tabla de Partidas Manuales -->
            <!-- Banner de Cotización Rechazada previa -->
            <div id="manual-rejection-alert" class="hidden p-3.5 bg-rose-50 border border-rose-200 rounded-2xl text-xs"></div>

            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                  <span>Partidas y Conceptos a Cobrar</span>
                  <span class="text-[10px] font-normal text-slate-400">(Ingresa precios unitarios a tu criterio)</span>
                </h3>
                <button
                  type="button"
                  id="btn-add-item-row"
                  class="px-3 py-1.5 text-xs font-bold bg-yelewhiteblue hover:bg-blue-100 text-yeleblue rounded-xl border border-blue-200 transition cursor-pointer flex items-center gap-1"
                >
                  + Agregar Fila
                </button>
              </div>

              <div class="overflow-x-auto border border-slate-200 rounded-2xl">
                <table class="w-full text-xs text-left">
                  <thead class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
                    <tr>
                      <th class="py-2.5 px-3 w-36">Tipo</th>
                      <th class="py-2.5 px-3">Descripción / Concepto</th>
                      <th class="py-2.5 px-3 w-20 text-center">Cant.</th>
                      <th class="py-2.5 px-3 w-28 text-right">P. Unit (S/.)</th>
                      <th class="py-2.5 px-3 w-28 text-right">Subtotal</th>
                      <th class="py-2.5 px-2 w-10 text-center"></th>
                    </tr>
                  </thead>
                  <tbody id="manual-items-tbody" class="divide-y divide-slate-100 bg-white">
                    <!-- Filas dinámicas generadas en JS -->
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Desglose de Totales Manuales -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
              <div class="space-y-3 text-xs bg-slate-50 p-4 rounded-2xl border border-slate-200">
                <h4 class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">Condiciones de la Oferta</h4>
                <div>
                  <label class="block font-medium text-slate-600 mb-1">Días de Validez</label>
                  <input type="number" id="manual-validity" value="15" min="1" max="90" class="w-full bg-white border border-slate-200 rounded-lg p-2 font-medium" />
                </div>
                <div>
                  <label class="block font-medium text-slate-600 mb-1">Tiempo Estimado de Ejecución</label>
                  <input type="text" id="manual-delivery" value="2 a 3 días hábiles tras confirmación" class="w-full bg-white border border-slate-200 rounded-lg p-2 font-medium" />
                </div>
                <div>
                  <label class="block font-medium text-slate-600 mb-1">Condiciones de Pago</label>
                  <input type="text" id="manual-payment" value="50% de anticipo y 50% al finalizar conformidad" class="w-full bg-white border border-slate-200 rounded-lg p-2 font-medium" />
                </div>
                <div>
                  <label class="block font-medium text-slate-600 mb-1">Observaciones / Garantía para el Cliente</label>
                  <textarea id="manual-notes" rows="2" placeholder="Ej: Incluye 6 meses de garantía por mano de obra técnica..." class="w-full bg-white border border-slate-200 rounded-lg p-2 font-medium"></textarea>
                </div>
              </div>

              <!-- Cuadro de Cálculo de Totales -->
              <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs flex flex-col justify-between space-y-3">
                <h4 class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">Resumen Económico</h4>
                
                <div class="space-y-2 bg-white p-3 rounded-xl border border-slate-200">
                  <div class="flex justify-between text-slate-600">
                    <span>Subtotal Materiales:</span>
                    <span class="font-semibold text-slate-800" id="calc-sub-mat">S/. 0.00</span>
                  </div>
                  <div class="flex justify-between text-slate-600">
                    <span>Subtotal Mano de Obra:</span>
                    <span class="font-semibold text-slate-800" id="calc-sub-labor">S/. 0.00</span>
                  </div>
                  <div class="flex items-center justify-between text-slate-600">
                    <span>Movilidad / Viáticos (S/.):</span>
                    <input type="number" id="calc-ops" value="0.00" step="5" min="0" class="w-24 text-right bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 font-semibold" />
                  </div>
                  <div class="flex items-center justify-between text-slate-600">
                    <span>Descuento Comercial (S/.):</span>
                    <input type="number" id="calc-discount" value="0.00" step="5" min="0" class="w-24 text-right bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 font-semibold text-rose-600" />
                  </div>
                  <div class="flex items-center justify-between text-slate-600 pt-1 border-t border-slate-100">
                    <label class="flex items-center gap-2 cursor-pointer font-medium text-slate-700 select-none">
                      <input type="checkbox" id="calc-include-igv" checked class="rounded border-slate-300 text-yeleblue focus:ring-yeleblue" />
                      <span>Incluir I.G.V. (18%)</span>
                    </label>
                    <span class="font-semibold text-slate-800" id="calc-igv">S/. 0.00</span>
                  </div>
                </div>

                <div class="p-3 bg-yelewhiteorange rounded-xl border border-orange-200 flex items-center justify-between">
                  <span class="font-extrabold text-xs text-yeledarkblue uppercase">TOTAL A COTIZAR:</span>
                  <span id="calc-total" class="text-xl font-black text-yeleorange">S/. 0.00</span>
                </div>
              </div>
            </div>

            <!-- Alerta del formulario -->
            <div id="manual-quote-alert" class="hidden p-3 rounded-xl text-xs font-medium"></div>

          </div>

          <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-end gap-3">
            <button
              type="button"
              id="btn-limpiar-cotizador"
              class="px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition cursor-pointer"
            >
              Limpiar Campos
            </button>
            <button
              type="button"
              id="btn-emit-manual-quote"
              class="px-6 py-2.5 rounded-xl text-xs font-bold text-white bg-yeleorange hover:bg-yeledarkorange shadow-md shadow-yeleorange/20 transition cursor-pointer flex items-center gap-2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/>
              </svg>
              <span>Aprobar y Emitir al Cliente</span>
            </button>
          </div>
        </div>

      </section>

    </main>

    <!-- MODAL: REGISTRAR NUEVO TÉCNICO -->
    <div id="tech-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-3xl max-w-lg w-full shadow-2xl border border-slate-100 animate-in fade-in zoom-in-95 duration-150">
        
        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-yelewhiteblue rounded-t-3xl">
          <div>
            <h3 class="text-base font-bold text-yeledarkblue">Dar de Alta a un Nuevo Técnico</h3>
            <p class="text-xs text-slate-500">Crea credenciales corporativas para tu personal de campo.</p>
          </div>
          <button type="button" id="close-tech-modal" class="p-2 text-slate-400 hover:text-slate-700 rounded-xl hover:bg-slate-200/50 transition cursor-pointer">
            ✕
          </button>
        </div>

        <form id="nuevo-tecnico-form" class="p-6 space-y-4 text-xs">
          <div id="tech-modal-alert" class="hidden p-3 rounded-xl font-medium"></div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Nombres *</label>
              <input type="text" id="tech-names" required placeholder="Ej: Mario" class="w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-yeleblue focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Apellidos *</label>
              <input type="text" id="tech-lastnames" required placeholder="Ej: Vargas" class="w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-yeleblue focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Correo Corporativo *</label>
              <input type="email" id="tech-email" required placeholder="tecnico@yele.com" class="w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-yeleblue focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Teléfono Móvil *</label>
              <input type="tel" id="tech-phone" required placeholder="987654321" pattern="9[0-9]{8}" maxlength="9" inputmode="numeric" class="w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-yeleblue focus:outline-none" />
            </div>
          </div>

          <div>
