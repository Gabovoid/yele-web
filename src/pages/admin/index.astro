      <div class="bg-white rounded-3xl max-w-lg w-full shadow-2xl border border-slate-100 animate-in fade-in zoom-in-95 duration-150 flex flex-col max-h-[85vh]">
        
        <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-yelewhiteblue rounded-t-3xl">
