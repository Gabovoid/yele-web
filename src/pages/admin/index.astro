        <div class="p-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/50 rounded-b-3xl">
          <button type="button" id="cancel-informe-detail" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 font-semibold hover:bg-slate-100 transition cursor-pointer text-xs">
            Cerrar
          </button>
          <button 
            type="button" 
            id="detail-proceder-cotizar-btn" 
            class="px-5 py-2.5 rounded-xl text-white font-bold bg-yeleorange hover:bg-yeledarkorange shadow-sm transition cursor-pointer text-xs flex items-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            <span>Proceder a Cotizar Este Informe Manualmente</span>
          </button>
