  </div>

  <!-- MODAL: DETALLE DEL INFORME TÉCNICO COMPLETO -->
    <div id="informe-detail-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-3xl max-w-2xl w-full shadow-2xl border border-slate-100 animate-in fade-in zoom-in-95 duration-150 flex flex-col max-h-[90vh]">
        
        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-yelewhiteblue rounded-t-3xl">
          <div>
            <h3 class="text-base font-bold text-yeledarkblue flex items-center gap-2">
              <span id="detail-informe-title">Expediente de Informe Técnico</span>
              <span id="detail-informe-priority" class="px-2 py-0.5 rounded-full text-[10px] uppercase font-bold bg-amber-100 text-amber-800 border border-amber-200">Media</span>
            </h3>
            <p class="text-xs text-slate-500" id="detail-informe-subtitle">Inspección de campo remitida por el personal técnico</p>
          </div>
          <button type="button" id="close-informe-detail-modal" class="p-2 text-slate-400 hover:text-slate-700 rounded-xl hover:bg-slate-200/50 transition cursor-pointer">
            ✕
          </button>
        </div>

        <div class="p-6 overflow-y-auto space-y-5 text-xs">
          <!-- Datos de la Cita y del Cliente -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-4 bg-slate-50 rounded-2xl border border-slate-200">
            <div>
              <span class="text-slate-400 block text-[10px] font-bold uppercase">Cliente Titular</span>
              <p class="font-bold text-slate-800 text-sm" id="detail-cliente-name">--</p>
              <p class="text-slate-500" id="detail-cliente-contact">--</p>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] font-bold uppercase">Ubicación / Dirección</span>
              <p class="font-medium text-slate-700" id="detail-cliente-address">--</p>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] font-bold uppercase">Técnico que Atendió</span>
              <p class="font-semibold text-yeledarkblue" id="detail-tecnico-name">--</p>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] font-bold uppercase">Horas Estimadas de Trabajo</span>
              <p class="font-mono font-bold text-slate-700" id="detail-horas-est">--</p>
            </div>
          </div>

          <!-- Diagnóstico Técnico -->
          <div>
            <h4 class="font-bold text-slate-700 uppercase tracking-wider text-[11px] mb-1.5 flex items-center gap-1.5">
